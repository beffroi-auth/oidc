{
    "name": "beffroi/oidc",
    "description": "OAuth 2.0 and OpenID Connect module of the IdP: clients, authorization requests, grants, tokens, discovery, JWKS, UserInfo, logout. Pure PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "oauth2",
        "openid-connect",
        "authorization-server"
    ],
    "authors": [
        {
            "name": "All contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "beffroi/core": "self.version",
        "spomky-labs/pki-framework": "^1.2.1",
        "web-token/jwt-library": "^4.2.7"
    },
    "autoload": {
        "psr-4": {
            "Beffroi\\Oidc\\": "src/"
        }
    },
    "extra": {
        "thanks": {
            "name": "beffroi/framework"
        }
    }
}
